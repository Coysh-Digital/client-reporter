APP_NAME="Client Reporter"
# Production-safe defaults. For local development set APP_ENV=local and
# APP_DEBUG=true; never run a real install with debug on — error pages would
# print configuration (including secrets) to whoever triggers them.
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://reports.example.com

# Behind a reverse proxy, load balancer or CDN, list the proxy addresses that
# may set X-Forwarded-* headers, or "*" for a CDN such as Cloudflare. Leave
# blank when the app is served directly. Needed for correct client IPs
# (rate limiting, audit log) and https detection.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# SQLite is the default and needs no extra setup (the file lives at
# database/database.sqlite). To use MySQL/MariaDB or PostgreSQL instead, set
# DB_CONNECTION and uncomment the matching block below.
DB_CONNECTION=sqlite

# MySQL / MariaDB
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=client_reporter
# DB_USERNAME=root
# DB_PASSWORD=

# PostgreSQL
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=client_reporter
# DB_USERNAME=postgres
# DB_PASSWORD=

# -----------------------------------------------------------------------------
# Sessions, cache, queue, filesystem
# -----------------------------------------------------------------------------
# File drivers are the defaults so sessions and cache work during the browser
# installer, before any database has been set up, and need nothing extra (like
# Redis) on shared hosting. On a VPS you can switch these to redis if you prefer.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Only send the session cookie over https. Set to false for a plain-http
# local development server.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

# Only needed if you switch the drivers above to memcached/redis.
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
# Defaults to "log" (emails are written to the log, not sent). Set MAIL_MAILER
# to "smtp" and fill in the host/port/credentials to actually send reports.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Client Reporter
# -----------------------------------------------------------------------------
# PDF rendering driver: "dompdf" (zero dependencies, shared-hosting safe) or
# "browsershot" (full Tailwind fidelity, requires Node + Chromium on the server).
CLIENT_REPORTER_PDF_DRIVER=dompdf
# Allow the dompdf PDF driver to load remote resources (e.g. an agency logo
# served over http). Enables logos in PDF reports.
LARAVEL_PDF_DOMPDF_REMOTE_ENABLED=true
# Signed connector request timestamp tolerance, in seconds (replay protection window).
CLIENT_REPORTER_CONNECTOR_TIMESTAMP_TOLERANCE=300
# Outbound requests to addresses staff type in (sites, self-hosted analytics,
# companion plugins, import sources) must resolve to a public address. If a
# service you connect lives on a private/LAN address, list its hostname(s)
# here (comma-separated) — or set ALLOW_PRIVATE_URLS=true to disable the check.
CLIENT_REPORTER_ALLOWED_HOSTS=
CLIENT_REPORTER_ALLOW_PRIVATE_URLS=false
# Lifetime ceiling (minutes) for MCP API tokens; 30 days by default.
# SANCTUM_TOKEN_EXPIRATION_MINUTES=43200
# Periodically check GitHub for a newer Client Reporter release and notify admins.
CLIENT_REPORTER_UPDATE_CHECK=true
# Where the in-app "Add integration" help link points.
# CLIENT_REPORTER_DOCS_INTEGRATIONS=https://github.com/coysh-digital/client-reporter/blob/main/docs/integrations/README.md

# -----------------------------------------------------------------------------
# Integration credentials (all optional — only needed for those integrations)
# -----------------------------------------------------------------------------
# Google OAuth — shared by Google Analytics 4, Google Ads and Google Search Console.
# Create an OAuth client at https://console.cloud.google.com/apis/credentials and
# register this redirect URI: <APP_URL>/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# FreeAgent OAuth (billing/invoice sync).
# Redirect URI: <APP_URL>/integrations/freeagent/callback
FREEAGENT_CLIENT_ID=
FREEAGENT_CLIENT_SECRET=

# Xero OAuth (billing/invoice sync).
# Redirect URI: <APP_URL>/integrations/xero/callback
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# API-key integrations (Plausible, Fathom, Matomo, Umami, Shopify, Stripe,
# UptimeRobot, Better Uptime, PageSpeed, Mailchimp, WooCommerce) and the
# WordPress/Craft companion connectors are configured per site inside the app —
# they need no .env entries.

# -----------------------------------------------------------------------------
# AWS / S3 (optional — only if you set FILESYSTEM_DISK=s3)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
